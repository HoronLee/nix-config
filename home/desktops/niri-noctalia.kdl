spawn-at-startup "noctalia"

binds {
    // Mod+D hotkey-overlay-title="Run an Application: Noctalia" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Alt+Space hotkey-overlay-title="Run an Application: Noctalia" {
        spawn "noctalia" "msg" "panel-toggle" "launcher"
    }
    Mod+B hotkey-overlay-title="Open Browser: Microsoft Edge" {
        spawn "microsoft-edge-stable"
    }
    Mod+E hotkey-overlay-title="File Manager: Nautilus" {
        spawn "nautilus"
    }
    Mod+S hotkey-overlay-title="Control Center: Noctalia" {
        spawn "noctalia" "msg" "panel-toggle" "control-center"
    }
    Mod+Shift+Q hotkey-overlay-title="Session Menu: Noctalia" {
        spawn "noctalia" "msg" "panel-toggle" "session"
    }
    Mod+Shift+Return hotkey-overlay-title="Wallpaper Selector: Noctalia" {
        spawn "noctalia" "msg" "panel-toggle" "wallpaper"
    }

    Super+Alt+L hotkey-overlay-title="Lock the Screen: Noctalia" {
        spawn "noctalia" "msg" "session" "lock"
    }
    // Keep clipboard history available when a remote app inhibits shortcuts.
    Mod+V allow-inhibiting=false hotkey-overlay-title="Clipboard History: Noctalia" {
        spawn "noctalia" "msg" "panel-toggle" "clipboard"
    }
    Mod+Shift+Comma hotkey-overlay-title="Settings: Noctalia" {
        spawn "noctalia" "msg" "settings-toggle"
    }
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-up" "10"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-down" "10"
    }
    XF86AudioMute allow-when-locked=true {
        spawn "noctalia" "msg" "volume-mute"
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn "noctalia" "msg" "mic-mute"
    }
    XF86AudioPlay allow-when-locked=true {
        spawn "noctalia" "msg" "media" "toggle"
    }
    XF86AudioStop allow-when-locked=true {
        spawn "noctalia" "msg" "media" "stop"
    }
    XF86AudioPrev allow-when-locked=true {
        spawn "noctalia" "msg" "media" "previous"
    }
    XF86AudioNext allow-when-locked=true {
        spawn "noctalia" "msg" "media" "next"
    }
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-up"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-down"
    }
}
