{
  "base_keymap": "Zed",
  "relative_line_numbers": "enabled",
  "soft_wrap": "editor_width",
  "session": {
    "trust_all_worktrees": true
  },
  "which_key": {
    "enabled": true
  },
  "vim_mode": true,
  "vim": {
    "show_edit_predictions_in_normal_mode": false,
    "gdefault": false,
    "cursor_shape": {
      "visual": "block",
      "normal": "block"
    },
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": false
  },
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "threads_sidebar": {
      "position": "right"
    }
  },
  "ui_font_family": "LXGW WenKai",
  "ui_font_size": 15.0,
  "buffer_font_family": "Maple Mono NF CN",
  "buffer_font_size": 15.0,
  "agent_buffer_font_size": 13.0,
  "markdown_preview": {
    "font_family": "LXGW WenKai",
    "code_font_family": "Maple Mono NF CN",
    "font_size": 17.0
  },
  "terminal": {
    "font_family": "Maple Mono NF CN",
    "font_size": 14.0
  }
}
